# Public URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Feature flags
NEXT_PUBLIC_PAYMENTS_VISIBLE=false

# Map settings
# NEXT_PUBLIC_PMTILES_URL=https://example.com/tiles.pmtiles

# Optional: Upstream API Overrides
# Use these if you want to route through a proxy or use your own self-hosted Overpass/Valhalla
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# VALHALLA_URL=https://valhalla1.openstreetmap.de/isochrone

# Stripe (Required if payments are visible)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
